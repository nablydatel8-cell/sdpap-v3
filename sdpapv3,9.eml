import sqlite3, hashlib, time, pathlib
DB=3Dpathlib.Path("audit.db")
def init_db():
 con=3Dsqlite3.connect(DB)
 con.execute("CREATE TABLE IF NOT EXISTS log (id INTEGER PRIMARY KEY, ts
TEXT, type TEXT, data_hash TEXT, data_preview TEXT, prev_hash TEXT,
entry_hash TEXT)")
 con.execute("CREATE TRIGGER IF NOT EXISTS forbid_update BEFORE UPDATE ON
log BEGIN SELECT RAISE(FAIL,'UPDATE forbidden'); END;")
 con.execute("CREATE TRIGGER IF NOT EXISTS forbid_delete BEFORE DELETE ON
log BEGIN SELECT RAISE(FAIL,'DELETE forbidden'); END;")
 con.commit(); con.close()
def add_entry(t,d,p=3D""):
 init_db(); h=3Dhashlib.sha256(d).hexdigest();
ts=3Dtime.strftime("%Y-%m-%dT%H:%M:%SZ",time.gmtime())
 con=3Dsqlite3.connect(DB); cur=3Dcon.cursor()
 cur.execute("SELECT entry_hash FROM log ORDER BY id DESC LIMIT 1");
r=3Dcur.fetchone(); ph=3Dr[0] if r else "0"*64
 eh=3Dhashlib.sha256(f"{ph}|{t}|{h}|{ts}".encode()).hexdigest()
 cur.execute("INSERT INTO log
(ts,type,data_hash,data_preview,prev_hash,entry_hash) VALUES
(?,?,?,?,?,?)",(ts,t,h,p[:200],ph,eh))
 con.commit(); con.close(); return eh

