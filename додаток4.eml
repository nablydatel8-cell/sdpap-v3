name: Upload Python Package
on:
  release:
    types: [published]

env:
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true

jobs:
  release-build:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          fetch-tags: true
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Fix version for tag v3.9-heroy-VIRTUAL
        run: |
          # =D0=B4=D0=B5=D0=BB=D0=B0=D0=B5=D0=BC PEP440-=D1=81=D0=BE=D0=B2=
=D0=BC=D0=B5=D1=81=D1=82=D0=B8=D0=BC=D1=83=D1=8E =D0=B2=D0=B5=D1=80=D1=81=
=D0=B8=D1=8E, =D1=82=D0=B2=D0=BE=D0=B9 =D1=82=D0=B5=D0=B3 =D0=BE=D1=81=D1=
=82=D0=B0=D0=B2=D0=BB=D1=8F=D0=B5=D0=BC =D0=BA=D0=B0=D0=BA =D0=B5=D1=81=D1=
=82=D1=8C
=D0=B4=D0=BB=D1=8F =D1=80=D0=B5=D0=BB=D0=B8=D0=B7=D0=B0
          sed -i 's/^version =3D.*/version =3D "3.9.0"/' pyproject.toml || =
echo
'version =3D "3.9.0"' >> pyproject.toml
          grep -A2 version pyproject.toml
      - name: Build
        run: |
          pip install build
          python -m build

  pypi-publish:
    needs: release-build
    runs-on: ubuntu-24.04
    if: github.event_name =3D=3D 'release'
    permissions:
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - name: Publish skipped for forensic release
        run: echo "skip pypi for VIRTUAL proof - release already anchored"

